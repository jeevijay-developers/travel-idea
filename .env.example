# Client-side (Vite exposes only VITE_* to the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Server-side / CLI / Edge Functions only — never prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Local app URL (Vite). Add this as Site URL + Redirect URL in Supabase Auth:
# http://localhost:8080
